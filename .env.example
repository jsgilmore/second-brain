COMPOSE_PROJECT_NAME=second-brain

POSTGRES_DB=brain
POSTGRES_USER=brain
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

N8N_PORT=5678
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_EDITOR_BASE_URL=http://localhost:5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me

MCP_API_PORT=8080
MCP_REMOTE_PORT=8000
EMBEDDING_DIMENSION=3072
DEFAULT_MAIL_SOURCE=gmail

EMBEDDING_PROVIDER=openai
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_EMBEDDING_MODEL=mxbai-embed-large
EMBED_QUERY_PREFIX=Represent this sentence for searching relevant passages: 

OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
CHUNK_SIZE=6000
CHUNK_OVERLAP=400

PUBLIC_BASE_URL=

REMOTE_MCP_AUTH_REQUIRED=true
REMOTE_MCP_GOOGLE_CLIENT_ID=
REMOTE_MCP_GOOGLE_CLIENT_SECRET=
REMOTE_ALLOWED_EMAILS=
REMOTE_ALLOWED_DOMAINS=
