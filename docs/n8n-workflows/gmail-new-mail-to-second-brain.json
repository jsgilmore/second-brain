{
  "name": "Gmail New Mail to Second Brain",
  "nodes": [
    {
      "parameters": {
        "pollTimes": {
          "item": [
            {
              "mode": "everyMinute"
            }
          ]
        },
        "simple": false
      },
      "id": "6b768935-71cb-4207-b842-e41475d9c214",
      "name": "Gmail Trigger",
      "type": "n8n-nodes-base.gmailTrigger",
      "typeVersion": 1,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const messageId = $json.id ?? $json.messageId ?? $json.message?.id;\nif (!messageId) {\n  throw new Error('No Gmail message id found in trigger payload');\n}\nreturn [{ json: { messageId } }];"
      },
      "id": "6d404564-a2f6-4e2e-bf42-4df56d213b3d",
      "name": "Extract Message Id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        500,
        300
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{'https://gmail.googleapis.com/gmail/v1/users/me/messages/' + $json.messageId}}",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleGmailOAuth2Api",
        "sendQuery": true,
        "queryParameters": {
          "parameters": [
            {
              "name": "format",
              "value": "full"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "fd941986-b608-457b-a94c-46dc60af9220",
      "name": "Fetch Full Gmail Message",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        760,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://mcp:8080/ingest/gmail",
        "sendBody": true,
        "contentType": "json",
        "specifyBody": "json",
        "jsonBody": "={{$json}}",
        "options": {
          "timeout": 300000
        }
      },
      "id": "7bceac70-c650-4f40-8c7d-39f68af22377",
      "name": "Index In Second Brain",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1020,
        300
      ]
    }
  ],
  "connections": {
    "Gmail Trigger": {
      "main": [
        [
          {
            "node": "Extract Message Id",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Extract Message Id": {
      "main": [
        [
          {
            "node": "Fetch Full Gmail Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Full Gmail Message": {
      "main": [
        [
          {
            "node": "Index In Second Brain",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {},
  "pinData": {},
  "versionId": "1c2c1c2f-8e73-4b00-a45f-0045893b99db",
  "meta": {
    "templateCredsSetupCompleted": false
  },
  "tags": []
}
